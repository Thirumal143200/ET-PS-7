# Environment Variables - CNI Cyber Resilience System
PROJECT_NAME="CNI AI Cyber Resilience System"
VERSION="1.0.0"
ENVIRONMENT="development"

# Security / JWT Secret
SECRET_KEY="cni_cyber_resilience_secret_key_change_in_production_2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration (PostgreSQL default, SQLite fallback)
DATABASE_URL="postgresql://cni_admin:cni_password@localhost:5432/cni_cyber_db"
# Fallback sqlite format: "sqlite:///./cni_cyber_db.sqlite"

# AI / LLM Integration (Optional - Fallback rule-based engines available when API keys not provided)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
LLM_MODEL="gemini-2.5-flash"

# ChromaDB Vectorstore
CHROMA_PERSIST_DIRECTORY="./chroma_db_data"

# Server Port Settings
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
FRONTEND_PORT=3000
